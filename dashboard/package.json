{
  "name": "@sherlock/dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Interviewer UI / Reviewer Dashboard (RFC §14; Plan M13): the 3-tier live badge and the full 8-state reviewer dashboard, with override actions, accommodation-disclosure flow, and an UNKNOWN-rate aggregate view.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "start": "serve -s dist -l ${PORT:-3000}",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:diagrams": "node scripts/capture-diagrams.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.61.1",
    "serve": "^14.2.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  }
}
