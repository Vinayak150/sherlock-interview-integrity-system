# Sherlock — environment configuration template (M0 scaffolding only).
# Copy to .env for local development: cp .env.example .env
# No secrets belong in this file or in .env if it is ever committed — this
# template only documents the variable names and safe local-dev defaults.

# --- Shared ---
NODE_ENV=development
LOG_LEVEL=info

# --- Orchestrator (modular monolith deployable, §9.2) ---
ORCHESTRATOR_SERVICE_NAME=orchestrator

# --- Model-Serving (GPU-bound deployable, §9.2) ---
MODEL_SERVING_SERVICE_NAME=model-serving
MODEL_SERVING_LOG_LEVEL=info

# --- Evidence Store (single relational database, §9.3 / ADR-7) ---
# Provisioned by docker-compose for local development. No schema/tables are
# created in M0 — this is infrastructure scaffolding only (see M1).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sherlock
POSTGRES_USER=sherlock
POSTGRES_PASSWORD=sherlock_dev_password

# --- Session Registry (lightweight KV, §9.4 / ADR-8) ---
# Provisioned by docker-compose for local development. No routing logic is
# implemented in M0 — this is infrastructure scaffolding only (see M7).
REDIS_URL=redis://localhost:6379
