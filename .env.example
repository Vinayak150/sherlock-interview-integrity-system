# Sherlock — environment configuration template (M0 scaffolding only).
# Copy to .env for local development: cp .env.example .env
# No secrets belong in this file or in .env if it is ever committed — this
# template only documents the variable names and safe local-dev defaults.

# --- Shared ---
NODE_ENV=development
LOG_LEVEL=info

# --- Orchestrator (modular monolith deployable, §9.2) ---
ORCHESTRATOR_SERVICE_NAME=orchestrator

# --- Model-Serving (GPU-bound deployable, §9.2) ---
MODEL_SERVING_SERVICE_NAME=model-serving
MODEL_SERVING_LOG_LEVEL=info

# --- Evidence Store (single relational database, §9.3 / ADR-7) ---
# Provisioned by docker-compose for local development. Schema is applied by
# `make migrate` (or `npm run migrate --workspace=@sherlock/orchestrator`),
# not automatically on process boot — see M1.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sherlock
POSTGRES_USER=sherlock
POSTGRES_PASSWORD=sherlock_dev_password

# Set to 'true' to run the opt-in Postgres integration suite
# (orchestrator/src/persistence/integration.test.ts) against the POSTGRES_*
# instance above. Left unset for the default, fast, mock-only test run.
RUN_DB_INTEGRATION_TESTS=false

# --- Session Registry (lightweight KV, §9.4 / ADR-8) ---
# Provisioned by docker-compose for local development. Session routing
# (M7) is implemented against this instance.
REDIS_URL=redis://localhost:6379

# Set to 'true' to run the opt-in Redis integration suite
# (orchestrator/src/routing/integration.test.ts) against the REDIS_URL
# instance above. Left unset for the default, fast, mock-only test run.
RUN_REDIS_INTEGRATION_TESTS=false

# This process's own identity on the consistent-hash ring (§9.4). Falls
# back to a randomly generated identifier per process start when unset —
# fine for local development and for the single-instance docker-compose
# topology; a real multi-replica deployment would assign this explicitly.
ORCHESTRATOR_REPLICA_ID=

# --- API layer ---
ORCHESTRATOR_HTTP_PORT=8080
ORCHESTRATOR_HTTP_HOST=0.0.0.0

# --- Model-Serving Layer (RFC §9.2/§9.6; Plan M8/M9) ---
MODEL_SERVING_URL=http://localhost:8081
MODEL_SERVING_HTTP_PORT=8081
MODEL_SERVING_HTTP_HOST=0.0.0.0

# --- Privacy & Compliance Layer (RFC §15/Pilot-readiness bar; Plan M16) ---
POSTGRES_SSL=false
# A real deployment MUST override this -- the default below is a local-dev-only placeholder.
FIELD_ENCRYPTION_KEY=sherlock_dev_field_encryption_key_32_bytes!!
DATA_RESIDENCY_REGION=us
