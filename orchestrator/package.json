{
  "name": "@sherlock/orchestrator",
  "version": "0.0.0",
  "private": true,
  "description": "Modular monolith deployable (RFC §9.2/§9.6): hosts the Bundle Adapters, Fusion Engine, State Manager, Decision/Alert Engine, Explanation Engine, session routing/recovery, and the API layer as in-process modules (M0-M8).",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "migrate": "node --import tsx src/persistence/migrate.ts",
    "migrate:built": "node dist/persistence/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sherlock/contracts": "*",
    "dotenv": "^16.4.7",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "pino": "^9.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
